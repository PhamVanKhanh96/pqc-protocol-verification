(* NEGATIVE CONTROL v91: omit SID from wrapping-key derivation only.
   One honest TX/RX pair, unbounded epochs and sessions per epoch. Enrollment,
   owner/device authentication, authority policy and atomic one-use state are
   premises. No ACK, no external PUF KDF, no biometric/physical security proof.
   Numeric widths are not modeled by types.
*)
type uid.
type device.
type challenge.
type helper.
type root.
type epoch.
type coins.
type sessionid.
type iv.
type mac.
type kemPK.
type kemSK.
type kemCT.
type shared.
type kek.
type contentKey.
type wrappedKey.
type dsaPK.
type dsaSK.
type signature.
type payloadCT.

free idTX, idRX: uid.
free c: channel.
const request, certRX, certTX: bitstring.

(* Exact successful reconstruction; no noise, entropy or learning model. *)
fun PUF(device, challenge): root [private].
fun MV(root): root.
fun BCH(root): helper.
fun BCH_decode(root, helper): root.
equation forall d:device, ch:challenge;
 BCH_decode(MV(PUF(d,ch)),BCH(MV(PUF(d,ch)))) = MV(PUF(d,ch)).

(* The SAME root is the PQC KeyGen input and recipient credential-HMAC key. *)
fun HMAC(root, bitstring): mac.
fun bodyRX(sessionid, challenge, helper, kemPK): bitstring [data].
fun bodyTX(sessionid, challenge, helper, dsaPK): bitstring [data].
fun KEMpk(root): kemPK.
fun KEMsk(root, coins): kemSK.
fun EncapsCT(kemPK, coins): kemCT.
fun EncapsSS(kemPK, coins): shared.
fun Decaps(kemSK, kemCT): shared.
equation forall d:root, z:coins, r:coins;
 Decaps(KEMsk(d,z),EncapsCT(KEMpk(d),r)) = EncapsSS(KEMpk(d),r).
(* Deliberate negative control: SHA256(SS)[last16], without SID. *)
fun ApplicationHashToKW(shared): kek.
fun Wrap(kek, contentKey): wrappedKey.
reduc forall k:kek, m:contentKey; Unwrap(k,Wrap(k,m)) = m.
fun DSApk(root): dsaPK.
fun DSAsk(root): dsaSK.
fun Sign(dsaSK, bitstring, coins): signature.
reduc forall d:root, m:bitstring, r:coins;
 Verify(DSApk(d),m,Sign(DSAsk(d),m,r)) = true.
(* Event label for authenticated session state only. This tuple is NOT
   encoded or passed to Sign/Verify; the application signing context is empty. *)
fun SessionRecord(uid,uid,sessionid,epoch,epoch): bitstring [data].

(* Ideal privacy plus only these selected CFB malleability operations.
   This is NOT a complete bit/block-level or padding-oracle CFB model. *)
fun Pair(bitstring, signature): bitstring [data].
fun Report(kemCT,wrappedKey,iv,payloadCT): bitstring [data].
fun CFBenc(contentKey,iv,bitstring): payloadCT.
fun ChangeMessage(payloadCT,bitstring): payloadCT.
fun ChangeSignature(payloadCT,signature): payloadCT.
fun CFBdec(contentKey,iv,payloadCT): bitstring.
equation forall k:contentKey,v:iv,p:bitstring;
 CFBdec(k,v,CFBenc(k,v,p)) = p.
equation forall k:contentKey,v:iv,m:bitstring,sg:signature,a:bitstring;
 CFBdec(k,v,ChangeMessage(CFBenc(k,v,Pair(m,sg)),a)) = Pair(a,sg).
equation forall k:contentKey,v:iv,m:bitstring,sg:signature,a:signature;
 CFBdec(k,v,ChangeSignature(CFBenc(k,v,Pair(m,sg)),a)) = Pair(m,a).

event Phase2Passed(uid,bitstring).
event RootTX(root).
event RootRX(root).
event SessionSecret(bitstring,shared).
event WrappingSecret(bitstring,kek).
event ContentSecret(bitstring,contentKey).
event MessageSecret(bitstring,bitstring).
event SigningKey(bitstring,dsaSK).
event DecapsulationKey(bitstring,kemSK).
event SigningCoins(bitstring,coins).
event IssuedRXKey(bitstring,kemPK).
event IssuedTXKey(bitstring,dsaPK).
event TXCheckedRX(bitstring,kemPK).
event RXCheckedTX(bitstring,dsaPK).
event RXRequested(bitstring).
event RXReserved(bitstring).
event TXSigned(bitstring,bitstring).
event TXSent(bitstring,bitstring).
event RXAccepted(bitstring,bitstring).
event TXReadyKey(bitstring,shared,contentKey).
event RXAcceptedKey(bitstring,shared,contentKey).

(* Protocol origin/key agreement controls and honest reachability. *)
query x:bitstring,m:bitstring; event(RXAccepted(x,m)) ==> event(TXSigned(x,m)).
query x:bitstring,ss:shared,k:contentKey; event(RXAcceptedKey(x,ss,k)) ==> event(TXReadyKey(x,ss,k)).
query x:bitstring,m:bitstring; event(RXAccepted(x,m)) ==> event(TXSent(x,m)).
query x:bitstring,m:bitstring; event(RXAccepted(x,m)).

let Server(st:channel,sr:channel,s:sessionid,et:epoch,er:epoch,
           rTX:root,cTX:challenge,hTX:helper,rRX:root,cRX:challenge,hRX:helper) =
 in(st,(=request,=idTX,=idRX,=s));
 let rec = SessionRecord(idTX,idRX,s,et,er) in
 let qTX = DSApk(rTX) in
 let qRX = KEMpk(rRX) in
 let tRX = HMAC(rTX,bodyRX(s,cTX,hTX,qRX)) in
 let tTX = HMAC(rRX,bodyTX(s,cRX,hRX,qTX)) in
 event IssuedRXKey(rec,qRX);
 out(st,(certRX,idTX,idRX,s,et,er,cTX,hTX,qRX,tRX));
 event IssuedTXKey(rec,qTX);
 out(sr,(certTX,idTX,idRX,s,et,er,cRX,hRX,qTX,tTX)).

let TX(rt:channel,st:channel,s:sessionid,et:epoch,er:epoch,
       devTX:device,cTX:challenge,hTX:helper) =
 in(rt,(=request,=idRX,=s));
 out(st,(request,idTX,idRX,s));
 in(st,(=certRX,=idTX,=idRX,=s,=et,=er,=cTX,=hTX,qRX:kemPK,tRX:mac));
 let rTX = BCH_decode(MV(PUF(devTX,cTX)),hTX) in
 if tRX = HMAC(rTX,bodyRX(s,cTX,hTX,qRX)) then
 let rec = SessionRecord(idTX,idRX,s,et,er) in
 event TXCheckedRX(rec,qRX);
 let dTX = DSAsk(rTX) in
 event SigningKey(rec,dTX);
 new rKEM:coins;
 new rSign:coins;
 new kContent:contentKey;
 new vector:iv;
 new m:bitstring;
 let ss = EncapsSS(qRX,rKEM) in
 let eSS = EncapsCT(qRX,rKEM) in
 let kWrap = ApplicationHashToKW(ss) in
 let eSK = Wrap(kWrap,kContent) in
 let sig = Sign(dTX,m,rSign) in
 event SessionSecret(rec,ss);
 event WrappingSecret(rec,kWrap);
 event ContentSecret(rec,kContent);
 event MessageSecret(rec,m);
 event SigningCoins(rec,rSign);
 event TXReadyKey(rec,ss,kContent);
 event TXSigned(rec,m);
 event TXSent(rec,m);
 out(c,(s,Report(eSS,eSK,vector,CFBenc(kContent,vector,Pair(m,sig))))).

let RX(rt:channel,sr:channel,s:sessionid,et:epoch,er:epoch,
       devRX:device,cRX:challenge,hRX:helper) =
 let rec = SessionRecord(idTX,idRX,s,et,er) in
 event RXRequested(rec);
 out(rt,(request,idRX,s));
 in(sr,(=certTX,=idTX,=idRX,=s,=et,=er,=cRX,=hRX,qTX:dsaPK,tTX:mac));
 (* Single opaque input for this transport-selected SID. No replicated
    receive/retry: even parse/check failure permanently ends this attempt. *)
 in(c,(=s,report:bitstring));
 event RXReserved(rec);
 let Report(eSS:kemCT,eSK:wrappedKey,vector:iv,ct:payloadCT) = report in
 let rRX = BCH_decode(MV(PUF(devRX,cRX)),hRX) in
 if tTX = HMAC(rRX,bodyTX(s,cRX,hRX,qTX)) then
 event RXCheckedTX(rec,qTX);
 new z:coins;
 let dRX = KEMsk(rRX,z) in
 event DecapsulationKey(rec,dRX);
 let ss = Decaps(dRX,eSS) in
 let kWrap = ApplicationHashToKW(ss) in
 let kContent = Unwrap(kWrap,eSK) in
 let Pair(m:bitstring,sig:signature) = CFBdec(kContent,vector,ct) in
 if Verify(qTX,m,sig) = true then
 event RXAcceptedKey(rec,ss,kContent);
 (* Durable acceptance-before-release is assumed by this terminal event;
    no receiver plaintext, receipt, timing or error oracle is public. *)
 event RXAccepted(rec,m);
 0.

let Setup(devTX:device,cTX:challenge,hTX:helper,rTX:root,
          devRX:device,cRX:challenge,hRX:helper,rRX:root,et:epoch,er:epoch) =
 new s:sessionid;
 let rec = SessionRecord(idTX,idRX,s,et,er) in
 (* Abstract successful fresh owner/device authentication BEFORE this setup.
    The token Hash(R||bio) is NOT extended with SID in this model or protocol.
    Freshness/status checks are premises of the protected authorization path. *)
 event Phase2Passed(idTX,rec);
 event Phase2Passed(idRX,rec);
 out(c,(s,et,er));
 (* Fresh private channels abstract authenticated, confidential, replay-safe
    links correlated to this setup. They are not extra protocol messages. *)
 new rt:channel; new st:channel; new sr:channel;
 (Server(st,sr,s,et,er,rTX,cTX,hTX,rRX,cRX,hRX) |
  TX(rt,st,s,et,er,devTX,cTX,hTX) |
  RX(rt,sr,s,et,er,devRX,cRX,hRX)).

process
 new devTX:device;
 new devRX:device;
 !(
  new cTX:challenge; new cRX:challenge;
  new et:epoch; new er:epoch;
  let rTX = MV(PUF(devTX,cTX)) in
  let rRX = MV(PUF(devRX,cRX)) in
  let hTX = BCH(rTX) in
  let hRX = BCH(rRX) in
  event RootTX(rTX); event RootRX(rRX);
  out(c,(idTX,idRX,cTX,hTX,cRX,hRX,et,er,DSApk(rTX),KEMpk(rRX)));
  !Setup(devTX,cTX,hTX,rTX,devRX,cRX,hRX,rRX,et,er)
 )
